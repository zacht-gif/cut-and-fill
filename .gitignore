# Python bytecode from the tools/
__pycache__/
*.py[cod]

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Marketing imagery for the itch.io page, regenerated by tools/shots.mjs.
# Rendered from index.html on demand, so storing it here would only let it
# drift from the game it is meant to show.
assets/screenshots/

# tools/solutions.json is a generated export (validate.py --json).
# The authoritative copy is the SOLUTIONS array inside index.html; keeping a
# second one in the tree only invites the two to drift.
tools/solutions.json
